{
  "name": "export-b2b",
  "version": "1.0.0",
  "description": "Premium international B2B export website for Indian agro/food-ingredient exporter",
  "private": true,
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "dev": "concurrently -n \"SERVER,CLIENT\" -c \"blue,green\" \"npm run dev --workspace=server\" \"npm run dev --workspace=client\"",
    "dev:server": "npm run dev --workspace=server",
    "dev:client": "npm run dev --workspace=client",
    "build": "npm run build --workspace=client",
    "build:client": "npm run build --workspace=client",
    "lint": "npm run lint --workspace=server && npm run lint --workspace=client",
    "test": "npm run test --workspace=server",
    "test:eval": "npm run test:eval --workspace=server",
    "test:audit": "npm run test:audit --workspace=server",
    "check:circular": "madge --circular server/src && madge --circular client/src"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.64.0",
    "concurrently": "^9.1.2",
    "madge": "^8.0.0"
  }
}
