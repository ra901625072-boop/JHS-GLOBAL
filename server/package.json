{
  "name": "export-b2b-server",
  "version": "1.0.0",
  "type": "module",
  "description": "REST API backend for Export B2B platform",
  "main": "src/server.js",
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "seed": "node src/seeds/index.js",
    "test": "vitest run --fileParallelism=false",
    "test:eval": "vitest run tests/buyerAssistant.evaluation.test.js --testTimeout=60000 --hookTimeout=60000",
    "test:audit": "vitest run tests/aiAuditLog.test.js",
    "test:watch": "vitest",
    "lint": "node --check src/server.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "compression": "^1.8.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "nodemailer": "^10.1.1",
    "pdfkit": "^0.20.2",
    "pg": "^8.23.1",
    "pg-hstore": "^2.3.4",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0",
    "sequelize": "^6.37.8",
    "slugify": "^1.6.6",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "nodemon": "^3.1.9",
    "supertest": "^7.0.0",
    "vitest": "^3.0.0"
  },
  "overrides": {
    "braces": "^3.0.3",
    "tinypool": ">=2.1.2",
    "uuid": ">=11.1.1"
  }
}
